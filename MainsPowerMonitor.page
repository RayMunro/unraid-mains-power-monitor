Menu="Settings:90"
Title="Mains Power Monitor"
Icon="bolt"
---
<?php
$name = 'mains-power-monitor';
$cfgDir = "/boot/config/plugins/$name";
$cfgFile = "$cfgDir/$name.cfg";
$stateFile = "/var/local/$name/state";
$pendingFile = "$cfgDir/pending-outage";
$lastFile = "$cfgDir/last-outage";
$rc = "/usr/local/emhttp/plugins/$name/scripts/rc.$name";
$test = "/usr/local/emhttp/plugins/$name/scripts/test-notification";

function load_kv($path) {
    $out = [];
    if (!is_file($path)) return $out;
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (strpos($line, '=') === false) continue;
        [$k, $v] = explode('=', $line, 2);
        $v = trim($v);
        if (strlen($v) >= 2 && $v[0] === '"' && substr($v, -1) === '"') {
            $v = stripcslashes(substr($v, 1, -1));
        }
        $out[trim($k)] = $v;
    }
    return $out;
}

function q($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
function cfg_line($k, $v) { return $k . '="' . addcslashes((string)$v, "\\\"") . "\"\n"; }

$msg = '';
$err = '';
$rawCfg = load_kv($cfgFile);
$cfg = array_merge([
    'ENABLED' => 'no',
    'TARGET_IP' => '10.10.20.5',
    'CHECK_INTERVAL' => '5',
    'PING_TIMEOUT' => '2',
    'FAIL_THRESHOLD' => '4',
    'RECOVERY_THRESHOLD' => '2',
], $rawCfg);

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? 'save';

    if ($action === 'test') {
        exec(escapeshellcmd($test) . ' >/dev/null 2>&1');
        $msg = 'Test notification queued through Unraid.';
    } elseif ($action === 'save') {
        $enabled = (($_POST['enabled'] ?? 'no') === 'yes') ? 'yes' : 'no';
        $ip = trim($_POST['target_ip'] ?? '');
        $interval = (int)($_POST['check_interval'] ?? 5);
        $timeout = (int)($_POST['ping_timeout'] ?? 2);
        $fail = (int)($_POST['fail_threshold'] ?? 4);
        $recover = (int)($_POST['recovery_threshold'] ?? 2);

        if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
            $err = 'Please enter a valid IPv4 address for the Raspberry Pi.';
        } elseif ($interval < 2 || $interval > 300) {
            $err = 'Check interval must be between 2 and 300 seconds.';
        } elseif ($timeout < 1 || $timeout > 10) {
            $err = 'Ping timeout must be between 1 and 10 seconds.';
        } elseif ($fail < 1 || $fail > 60 || $recover < 1 || $recover > 60) {
            $err = 'Failure and recovery thresholds must be between 1 and 60 checks.';
        } else {
            if (!is_dir($cfgDir)) mkdir($cfgDir, 0755, true);
            $body = '';
            $body .= cfg_line('ENABLED', $enabled);
            $body .= cfg_line('TARGET_IP', $ip);
            $body .= cfg_line('CHECK_INTERVAL', $interval);
            $body .= cfg_line('PING_TIMEOUT', $timeout);
            $body .= cfg_line('FAIL_THRESHOLD', $fail);
            $body .= cfg_line('RECOVERY_THRESHOLD', $recover);
            file_put_contents($cfgFile, $body, LOCK_EX);
            @chmod($cfgFile, 0644);
            exec(escapeshellcmd($rc) . ' restart >/dev/null 2>&1');
            $msg = 'Settings saved and monitor restarted.';
            $cfg = array_merge($cfg, load_kv($cfgFile));
        }
    }
}

$state = load_kv($stateFile);
$pending = load_kv($pendingFile);
$last = load_kv($lastFile);
$status = $state['STATUS'] ?? 'UNKNOWN';
$detail = $state['DETAIL'] ?? 'No status has been recorded yet.';
$updated = $state['UPDATED'] ?? 'Never';
$statusClass = ($status === 'ONLINE') ? 'green' : (($status === 'OFFLINE' || $status === 'ERROR' || $status === 'SHUTTING_DOWN') ? 'red' : (($status === 'RECOVERED') ? '#d58512' : '#888'));
?>

<style>
.mpm-card{max-width:920px;padding:18px 22px;border:1px solid #ccc;border-radius:8px;margin:12px 0 22px 0}
.mpm-status{font-size:22px;font-weight:600;margin-bottom:6px}
.mpm-grid{display:grid;grid-template-columns:270px minmax(240px,420px);gap:12px 18px;align-items:center}
.mpm-grid input[type=text],.mpm-grid input[type=number],.mpm-grid select{width:100%}
.mpm-actions{margin-top:20px;display:flex;gap:10px;flex-wrap:wrap}
.mpm-note{color:#777;margin-top:8px;line-height:1.45}
.mpm-kv{display:grid;grid-template-columns:180px 1fr;gap:7px 14px;margin-top:12px}
</style>

<?php if ($msg): ?><div class="notice"><?=q($msg)?></div><?php endif; ?>
<?php if ($err): ?><div class="error"><?=q($err)?></div><?php endif; ?>

<div class="mpm-card">
  <div class="mpm-status">Current status: <span style="color:<?=q($statusClass)?>"><?=q($status)?></span></div>
  <div><?=q($detail)?></div>
  <div class="mpm-note">Last updated: <?=q($updated)?></div>
  <?php if (!empty($pending['START_TEXT'])): ?>
  <div class="mpm-kv">
    <b>Pending outage began</b><span><?=q($pending['START_TEXT'])?></span>
    <b>Report status</b><span>Saved locally. A Warning summary will be sent after connectivity returns, even if Unraid reboots first.</span>
    <?php if (!empty($pending['SHUTDOWN_TEXT'])): ?><b>Unraid stopped/shut down</b><span><?=q($pending['SHUTDOWN_TEXT'])?></span><?php endif; ?>
  </div>
  <?php endif; ?>
</div>

<form method="post">
<input type="hidden" name="csrf_token" value="<?=q($var['csrf_token'] ?? '')?>">
<input type="hidden" name="action" value="save">
<div class="mpm-grid">
  <label for="enabled">Enable monitoring</label>
  <select id="enabled" name="enabled">
    <option value="yes" <?=($cfg['ENABLED'] ?? 'no') === 'yes' ? 'selected' : ''?>>Yes</option>
    <option value="no" <?=($cfg['ENABLED'] ?? 'no') !== 'yes' ? 'selected' : ''?>>No</option>
  </select>

  <label for="target_ip">Raspberry Pi IPv4 address</label>
  <input id="target_ip" name="target_ip" type="text" value="<?=q($cfg['TARGET_IP'] ?? '')?>" placeholder="10.10.20.5">

  <label for="check_interval">Check interval (seconds)</label>
  <input id="check_interval" name="check_interval" type="number" min="2" max="300" value="<?=q($cfg['CHECK_INTERVAL'] ?? '5')?>">

  <label for="ping_timeout">Ping timeout (seconds)</label>
  <input id="ping_timeout" name="ping_timeout" type="number" min="1" max="10" value="<?=q($cfg['PING_TIMEOUT'] ?? '2')?>">

  <label for="fail_threshold">Failed checks before clean shutdown</label>
  <input id="fail_threshold" name="fail_threshold" type="number" min="1" max="60" value="<?=q($cfg['FAIL_THRESHOLD'] ?? '4')?>">

  <label for="recovery_threshold">Successful checks before recovery</label>
  <input id="recovery_threshold" name="recovery_threshold" type="number" min="1" max="60" value="<?=q($cfg['RECOVERY_THRESHOLD'] ?? '2')?>">

  <label>Recovery notification severity</label>
  <div><b>Warning</b> — sent through Unraid's configured notification agents.</div>
</div>

<div class="mpm-actions"><button type="submit">Apply</button></div>
</form>

<form method="post" style="margin-top:10px">
  <input type="hidden" name="csrf_token" value="<?=q($var['csrf_token'] ?? '')?>">
  <input type="hidden" name="action" value="test">
  <button type="submit">Send Test Notification</button>
  <button type="button" onclick="location.reload()">Refresh Status</button>
</form>

<?php if (!empty($last['START_TEXT'])): ?>
<div class="mpm-card">
  <b>Last detected outage</b>
  <div class="mpm-kv">
    <b>Detected loss</b><span><?=q($last['START_TEXT'])?></span>
    <?php if (!empty($last['SHUTDOWN_TEXT'])): ?><b>Unraid stopped/shut down</b><span><?=q($last['SHUTDOWN_TEXT'])?></span><?php endif; ?>
    <?php if (($last['REBOOTED'] ?? 'no') === 'yes'): ?><b>Unraid restarted</b><span><?=q($last['RESTART_TEXT'] ?? 'Unknown')?></span><?php endif; ?>
    <b>Connectivity confirmed</b><span><?=q($last['END_TEXT'] ?? 'Unknown')?></span>
    <b>Loss-to-recovery interval</b><span><?=q($last['DURATION'] ?? 'Unknown')?></span>
  </div>
</div>
<?php endif; ?>

<div class="mpm-card">
  <b>Designed for your network layout</b>
  <div class="mpm-note">This mode assumes the Raspberry Pi, router and switches are on normal mains while Unraid remains UPS-backed. When the Pi reaches the configured consecutive-failure threshold, the outage is saved on the Unraid flash drive and the plugin immediately asks Unraid to perform its native clean shutdown. The shutdown is stamped into the pending record. On the next boot, once the Pi/network is reachable, Unraid sends one Warning summary through its configured notification agents.</div>
  <div class="mpm-note"><b>Shutdown behaviour:</b> Reaching the failure threshold automatically powers down Unraid. With the default 5-second interval and four-failure threshold this is intentionally fast, so make sure the monitored Pi has a fixed IP and is normally reliable.</div>
  <div class="mpm-note"><b>Limitation:</b> because the whole mains-powered network path disappears together, the plugin cannot distinguish a household mains cut from a reboot or failure of the router/switch/Pi. If Unraid itself is off when mains returns, the exact restoration time cannot be observed; the report therefore gives the time connectivity was confirmed after Unraid restarted.</div>
</div>
